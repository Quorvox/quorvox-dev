{
  "name": "quorvox-dev",
  "displayName": "Quorvox Dev",
  "description": "%description%",
  "version": "0.11.0",
  "publisher": "QuorvoxTeam",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Quorvox/quorvox-dev.git"
  },
  "homepage": "https://github.com/Quorvox/quorvox-dev#readme",
  "bugs": {
    "url": "https://github.com/Quorvox/quorvox-dev/issues"
  },
  "keywords": [
    "live reload",
    "dev server",
    "express",
    "frontend",
    "css",
    "deploy",
    "vps",
    "qr",
    "mobile",
    "autocomplete",
    "diagnostics",
    "project map",
    "flask",
    "fastapi",
    "python",
    "refactor",
    "move files"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Linters"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%untrusted%"
    }
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "quorvox",
          "title": "Quorvox",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "quorvox": [
        {
          "id": "quorvox.services",
          "name": "%view.services%"
        },
        {
          "id": "quorvox.checks",
          "name": "%view.checks%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "quorvox.services",
        "contents": "%welcome%",
        "when": "quorvox.noServices"
      }
    ],
    "commands": [
      {
        "command": "quorvox.toggle",
        "title": "%cmd.toggle%",
        "icon": "$(debug-start)"
      },
      {
        "command": "quorvox.dashboard",
        "title": "%cmd.dashboard%",
        "icon": "$(layout)"
      },
      {
        "command": "quorvox.open",
        "title": "%cmd.open%",
        "icon": "$(globe)"
      },
      {
        "command": "quorvox.showLogs",
        "title": "%cmd.showLogs%"
      },
      {
        "command": "quorvox.rescan",
        "title": "%cmd.rescan%",
        "icon": "$(refresh)"
      },
      {
        "command": "quorvox.check",
        "title": "%cmd.check%",
        "icon": "$(checklist)"
      },
      {
        "command": "quorvox.map",
        "title": "%cmd.map%",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "quorvox.phone",
        "title": "%cmd.phone%",
        "icon": "$(device-mobile)"
      },
      {
        "command": "quorvox.phoneOff",
        "title": "%cmd.phoneOff%"
      },
      {
        "command": "quorvox.deploy",
        "title": "%cmd.deploy%",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "quorvox.rollback",
        "title": "%cmd.rollback%"
      },
      {
        "command": "quorvox.editorToggle",
        "title": "%cmd.editorToggle%"
      },
      {
        "command": "quorvox.releaseOk",
        "title": "%cmd.releaseOk%"
      },
      {
        "command": "quorvox.envExample",
        "title": "%cmd.envExample%"
      },
      {
        "command": "quorvox.import",
        "title": "%cmd.import%"
      },
      {
        "command": "quorvox.onboard",
        "title": "%cmd.onboard%"
      },
      {
        "command": "quorvox.move",
        "title": "%cmd.move%"
      },
      {
        "command": "quorvox.moveUndo",
        "title": "%cmd.moveUndo%"
      },
      {
        "command": "quorvox.openFinding",
        "title": "%cmd.openFinding%"
      },
      {
        "command": "quorvox.service.start",
        "title": "%cmd.service.start%",
        "icon": "$(play)"
      },
      {
        "command": "quorvox.service.stop",
        "title": "%cmd.service.stop%",
        "icon": "$(debug-stop)"
      },
      {
        "command": "quorvox.service.restart",
        "title": "%cmd.service.restart%",
        "icon": "$(debug-restart)"
      },
      {
        "command": "quorvox.service.open",
        "title": "%cmd.service.open%",
        "icon": "$(globe)"
      },
      {
        "command": "quorvox.language",
        "title": "%cmd.language%"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "quorvox.openFinding",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "quorvox.move",
          "when": "workspaceFolderCount >= 1 && !explorerResourceIsRoot",
          "group": "7_modification@9"
        }
      ],
      "view/title": [
        {
          "command": "quorvox.check",
          "when": "view == quorvox.checks",
          "group": "navigation"
        },
        {
          "command": "quorvox.map",
          "when": "view == quorvox.services",
          "group": "navigation@0"
        },
        {
          "command": "quorvox.deploy",
          "when": "view == quorvox.services",
          "group": "navigation@4"
        },
        {
          "command": "quorvox.toggle",
          "when": "view == quorvox.services",
          "group": "navigation@1"
        },
        {
          "command": "quorvox.dashboard",
          "when": "view == quorvox.services",
          "group": "navigation@2"
        },
        {
          "command": "quorvox.rescan",
          "when": "view == quorvox.services",
          "group": "navigation@3"
        },
        {
          "command": "quorvox.language",
          "when": "view == quorvox.services",
          "group": "9_language"
        }
      ],
      "view/item/context": [
        {
          "command": "quorvox.service.start",
          "when": "view == quorvox.services && viewItem =~ /stopped/",
          "group": "inline@1"
        },
        {
          "command": "quorvox.service.restart",
          "when": "view == quorvox.services && viewItem =~ /running|crashed/",
          "group": "inline@1"
        },
        {
          "command": "quorvox.service.stop",
          "when": "view == quorvox.services && viewItem =~ /running|crashed/",
          "group": "inline@2"
        },
        {
          "command": "quorvox.service.open",
          "when": "view == quorvox.services && viewItem =~ /live/",
          "group": "inline@3"
        },
        {
          "command": "quorvox.phone",
          "when": "view == quorvox.services && viewItem =~ /live/",
          "group": "inline@4"
        }
      ]
    },
    "configuration": {
      "title": "Quorvox Dev",
      "properties": {
        "quorvox.autoRestart": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.autoRestart%"
        },
        "quorvox.editor.diagnostics": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.editor.diagnostics%"
        },
        "quorvox.editor.completions": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.editor.completions%"
        },
        "quorvox.fixLinksOnMove": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.fixLinksOnMove%"
        },
        "quorvox.showDashboardOnStart": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.showDashboardOnStart%"
        },
        "quorvox.language": {
          "type": "string",
          "enum": [
            "auto",
            "ru",
            "en"
          ],
          "enumDescriptions": [
            "%cfg.language.auto%",
            "Русский",
            "English"
          ],
          "default": "auto",
          "description": "%cfg.language%"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check": "tsc --noEmit",
    "test:vscode": "node test-vscode/run.mjs",
    "test": "node --test --test-concurrency=1 --test-timeout=60000 \"test/*.test.ts\"",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "qrcode-generator": "2.0.4"
  }
}
